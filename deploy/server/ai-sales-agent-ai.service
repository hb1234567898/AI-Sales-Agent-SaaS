[Unit]
Description=AI Sales Agent LangChain service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/www/wwwroot/ai.likeasuka.icu/current/ai-service/runtime
EnvironmentFile=/etc/ai-sales-agent/backend.env
ExecStart=/www/wwwroot/ai.likeasuka.icu/shared/ai-service-venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 2
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
