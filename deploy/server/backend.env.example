SERVER_PORT=8080

DB_URL=jdbc:postgresql://127.0.0.1:5433/ai_sales_agent
DB_USER=ai_sales_agent
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10

# 使用 openssl rand -base64 32 生成，只保存在服务器环境中，禁止提交到 Git。
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# JWT 签名密钥必须独立、固定且至少 32 字节；更换它会让所有用户重新登录。
# 可使用 openssl rand -base64 32 生成。
AUTH_JWT_SIGNING_KEY=replace-with-base64-encoded-32-byte-key
AUTH_ACCESS_TOKEN_DURATION=PT15M
AUTH_SESSION_DURATION=PT12H
AUTH_REMEMBER_DURATION=P30D
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 真实邮件发送通道。未配置时发送动作会标记 FAILED，不会影响审批流。
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=notifications@example.com
# MAIL_PASSWORD=replace-with-smtp-password
# MAIL_FROM=notifications@example.com
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_STARTTLS_REQUIRED=true

DEMO_SEED_ENABLED=false
