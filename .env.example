POSTGRES_DB=ai_sales_agent
POSTGRES_USER=ai_sales_agent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/ai_sales_agent
DB_USER=ai_sales_agent
DB_PASSWORD=change-me

# 本地演示账号的初始密码。生产环境必须修改并关闭演示数据初始化。
DEMO_LOGIN_PASSWORD=Demo@123456
DEMO_SEED_ENABLED=true
AUTH_COOKIE_SECURE=false

# 千问默认模型信息；API Key 由登录用户在“设置 -> AI 模型”中配置。
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Java 业务服务与 Python AI 服务之间的内部连接配置。
AI_SERVICE_BASE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=replace-with-a-random-internal-token

# 真实邮件发送通道（SendEmailTool 使用）。未配置时发送动作会标记 FAILED 而非崩溃。
# 本地开发可用 Mailpit / MailHog 等假 SMTP，或用真实邮箱的 SMTP。
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=notifications@example.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM=notifications@example.com
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_STARTTLS_REQUIRED=true
# MAIL_HEALTH_ENABLED=false
